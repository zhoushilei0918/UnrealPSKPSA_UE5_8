#. Key:	PsaImportSettings:bRepairInvalidKeys
#. SourceLocation:	/Script/UnrealPSKPSA.PsaImportSettings:bRepairInvalidKeys [BoolProperty DisplayName meta-data]
#: /Script/UnrealPSKPSA.PsaImportSettings:bRepairInvalidKeys [BoolProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,PsaImportSettings:bRepairInvalidKeys"
msgid "Repair Invalid Keys"
msgstr "Repair Invalid Keys"

#. Key:	PsaImportSettings:bRepairInvalidKeys
#. SourceLocation:	/Script/UnrealPSKPSA.PsaImportSettings:bRepairInvalidKeys [BoolProperty ToolTip meta-data]
#: /Script/UnrealPSKPSA.PsaImportSettings:bRepairInvalidKeys [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,PsaImportSettings:bRepairInvalidKeys"
msgid "Off by default. Repair keys per animation and bone: interpolate interior gaps; copy the nearest valid frame at either end; fail if the entire track is invalid. Position, rotation, and scale are repaired together. Repairs estimate poses and do not recover the original motion."
msgstr "Off by default. Repair keys per animation and bone: interpolate interior gaps; copy the nearest valid frame at either end; fail if the entire track is invalid. Position, rotation, and scale are repaired together. Repairs estimate poses and do not recover the original motion."

#. Key:	PsaImportSettings:bReplaceExisting
#. SourceLocation:	/Script/UnrealPSKPSA.PsaImportSettings:bReplaceExisting [BoolProperty DisplayName meta-data]
#: /Script/UnrealPSKPSA.PsaImportSettings:bReplaceExisting [BoolProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,PsaImportSettings:bReplaceExisting"
msgid "Replace Existing Animations"
msgstr "Replace Existing Animations"

#. Key:	PsaImportSettings:bReplaceExisting
#. SourceLocation:	/Script/UnrealPSKPSA.PsaImportSettings:bReplaceExisting [BoolProperty ToolTip meta-data]
#: /Script/UnrealPSKPSA.PsaImportSettings:bReplaceExisting [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,PsaImportSettings:bReplaceExisting"
msgid "Off by default: generate a unique name. When enabled, overwrite only animation sequences using the same Skeleton."
msgstr "Off by default: generate a unique name. When enabled, overwrite only animation sequences using the same Skeleton."

#. Key:	PsaImportSettings:bUseReferenceScale
#. SourceLocation:	/Script/UnrealPSKPSA.PsaImportSettings:bUseReferenceScale [BoolProperty DisplayName meta-data]
#: /Script/UnrealPSKPSA.PsaImportSettings:bUseReferenceScale [BoolProperty DisplayName meta-data]
